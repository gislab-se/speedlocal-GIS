{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedlocal.local/schemas/1.0/region-package-questions.schema.json",
  "title": "SpeedLocal frågekatalog 1.0",
  "description": "Maskinkontrakt för varje begriplig fråga i regionblanketten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalog_schema_version",
    "form_schema_version",
    "questions_version",
    "operator_language",
    "sections",
    "questions"
  ],
  "properties": {
    "$schema": {
      "const": "./region-package-questions.schema.json"
    },
    "catalog_schema_version": {
      "const": "1.0"
    },
    "form_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "questions_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "operator_language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "non_empty_text": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "$ref": "#/$defs/non_empty_text"
        },
        "description": {
          "$ref": "#/$defs/non_empty_text"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "target_path",
        "type",
        "unit",
        "required_when",
        "allowed_values",
        "example",
        "help",
        "activates",
        "error_if_missing",
        "generated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "question": {
          "$ref": "#/$defs/non_empty_text"
        },
        "target_path": {
          "type": "string",
          "pattern": "^/"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "boolean",
            "number",
            "integer",
            "choice",
            "list",
            "file_reference",
            "date",
            "uri"
          ]
        },
        "unit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/non_empty_text"}
          ]
        },
        "required_when": {
          "$ref": "#/$defs/non_empty_text"
        },
        "allowed_values": {
          "oneOf": [
            {"type": "null"},
            {"type": "array"},
            {"type": "object"}
          ]
        },
        "example": {},
        "help": {
          "$ref": "#/$defs/non_empty_text"
        },
        "activates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_text"
          }
        },
        "error_if_missing": {
          "$ref": "#/$defs/non_empty_text"
        },
        "generated": {
          "type": "boolean"
        }
      }
    }
  }
}
