{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gislab.se/schemas/speedlocal/1.0/region-source-catalog.schema.json",
  "title": "SpeedLocal region source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region_id", "groups"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "region_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/group"}
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason", "sources"],
      "properties": {
        "id": {
          "enum": [
            "roads",
            "population",
            "nature",
            "culture",
            "grid_infrastructure"
          ]
        },
        "status": {"enum": ["candidate", "pending_inventory", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "database_view",
        "authority",
        "dataset",
        "snapshot_date",
        "license",
        "public_display_status",
        "selection",
        "source_feature_count",
        "geometry_family",
        "data_representation",
        "asset"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1},
        "database_view": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "authority": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "snapshot_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "status"],
          "properties": {
            "name": {"type": ["string", "null"], "minLength": 1},
            "url": {"type": ["string", "null"], "format": "uri"},
            "status": {
              "enum": [
                "verified_local_delivery",
                "locally_documented_not_live_verified",
                "unverified"
              ]
            }
          }
        },
        "public_display_status": {
          "enum": ["eligible_for_delivery_review", "local_review_only", "blocked"]
        },
        "local_review_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "authorized_by", "authorized_on", "reason"],
          "properties": {
            "scope": {"const": "local_review"},
            "authorized_by": {"type": "string", "minLength": 1},
            "authorized_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "selection": {"type": "string", "minLength": 1},
        "source_feature_count": {"type": "integer", "minimum": 1},
        "geometry_family": {"enum": ["line", "point", "polygon"]},
        "data_representation": {
          "enum": ["network", "features", "grid", "privacy_protected_surface"]
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "path",
            "sha256",
            "format",
            "source_crs",
            "expected_feature_count"
          ],
          "properties": {
            "provider": {"enum": ["generated_runtime", "v2_archive"]},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "format": {"const": "geojson"},
            "source_crs": {"const": "EPSG:4326"},
            "expected_feature_count": {"type": "integer", "minimum": 1}
          }
        }
      },
      "allOf": [{
        "if": {"required": ["local_review_authorization"]},
        "then": {"properties": {"public_display_status": {"const": "local_review_only"}}}
      }]
    }
  }
}
